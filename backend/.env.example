# 此文件为模板；dev从backend或server目录启动时读取backend/.env。
# ADMIN_PASSWORD 填写明文或 BCrypt 哈希均可，启动时自动识别。
ADMIN_PASSWORD=
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8083
DB_URL=jdbc:mysql://localhost:3306/gww?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
ADMIN_USERNAME=admin
# 核实宝塔目录后填写独立的绝对路径，禁止指向.output、JAR或网站构建目录。
MEDIA_PUBLIC_ROOT=
MEDIA_PRIVATE_ROOT=
MEDIA_PUBLIC_URL_PREFIX=/media/
MEDIA_MAX_UPLOAD_BYTES=20971520
