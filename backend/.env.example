# 此文件为模板；dev从backend或server目录启动时读取backend/.env。
# Redis目前禁用，REDIS_*暂不生效；ADMIN_PASSWORD仅供dev使用。
# ADMIN_PASSWORD_HASH仍只能填写BCrypt哈希，prod必须提供哈希。
ADMIN_PASSWORD=
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/gww?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=xianglai321
# 核实宝塔目录后填写独立的绝对路径，禁止指向.output、JAR或网站构建目录。
MEDIA_PUBLIC_ROOT=
MEDIA_PRIVATE_ROOT=
MEDIA_PUBLIC_URL_PREFIX=/media/
MEDIA_MAX_UPLOAD_BYTES=20971520
