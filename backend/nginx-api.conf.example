# 合并到核实后的宝塔HTTPS站点server块，不能直接覆盖已有配置。
location ^~ /api/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 21m;
    proxy_read_timeout 60s;
}

# 下方占位符必须替换成已核实的MEDIA_PUBLIC_ROOT；私有目录禁止配置alias。
location ^~ /media/ {
    alias __VERIFIED_PUBLIC_MEDIA_ROOT__/;
    autoindex off;
    add_header X-Content-Type-Options nosniff always;
    if ($uri !~* "\.(jpg|jpeg|png|webp|mp4|pdf)$") {
        return 403;
    }
}
