{
  "name": "materials-showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:smoke": "node tests/smoke.mjs",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write app server tests nuxt.config.ts playwright.config.ts package.json"
  },
  "dependencies": {
    "nuxt": "4.6.2",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13"
  }
}
