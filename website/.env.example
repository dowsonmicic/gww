# ========== 前端 (website) 环境变量模板 ==========
# 复制为 .env 然后按环境填写。.env 不入 git。

# 后端 API 基址（本地开发用 8083，部署后改成服务器内网地址）
NUXT_JAVA_API_BASE=http://127.0.0.1:8083

# 正式域名（生产必改！）
NUXT_PUBLIC_SITE_URL=https://yourdomain.com

# 公司信息（后台 SiteSettings 会覆盖这里的值；这里是兜底）
NUXT_PUBLIC_COMPANY_NAME=GWW
NUXT_PUBLIC_COMPANY_NAME_EN=GWW Specialty Materials
NUXT_PUBLIC_CONTACT_EMAIL=info@gww.com
NUXT_PUBLIC_CONTACT_PHONE=+86-xxx-xxxx
